{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["esnext", "es2021.intl", "dom"],
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": [
      "../node_modules/@dynatrace/js-runtime/types",
      "../node_modules/@types"
    ],
    "types": ["node", "runtime"]
  }
}
