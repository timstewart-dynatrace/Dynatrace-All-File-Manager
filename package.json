{
  "name": "dt-file-manager",
  "version": "0.1.0",
  "description": "A collection of file management utilities for Dynatrace",
  "scripts": {
    "build": "dt-app build",
    "start": "dt-app dev",
    "create:function": "dt-app function create",
    "create:action": "dt-app action create",
    "uninstall": "dt-app uninstall",
    "deploy": "dt-app deploy",
    "deploy:notebooks": "node scripts/with-target.mjs notebooks npm run deploy",
    "deploy:dashboards": "node scripts/with-target.mjs dashboards npm run deploy",
    "deploy:lookup": "node scripts/with-target.mjs lookup npm run deploy",
    "deploy:documents": "node scripts/with-target.mjs documents npm run deploy",
    "start:notebooks": "node scripts/with-target.mjs notebooks npm run start",
    "start:dashboards": "node scripts/with-target.mjs dashboards npm run start",
    "start:lookup": "node scripts/with-target.mjs lookup npm run start",
    "start:documents": "node scripts/with-target.mjs documents npm run start",
    "update": "dt-app update",
    "info": "dt-app info",
    "help": "dt-app help",
    "lint": "eslint .",
    "test": "tsx --test ui/app/utils/__tests__/csv.test.ts ui/app/utils/__tests__/document.test.ts ui/app/utils/__tests__/validation.test.ts",
    "check:version": "node scripts/check-version-sync.mjs",
    "predeploy": "node scripts/check-version-sync.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@dynatrace-sdk/app-environment": "^1.1.4",
    "@dynatrace-sdk/app-utils": "^1.0.2",
    "@dynatrace-sdk/client-classic-environment-v2": "^6.1.0",
    "@dynatrace-sdk/client-grail": "file:./mocks/client-grail",
    "@dynatrace-sdk/client-query": "^1.26.0",
    "@dynatrace-sdk/error-handlers": "^1.3.1",
    "@dynatrace-sdk/navigation": "^2.2.1",
    "@dynatrace-sdk/react-hooks": "^1.14.1",
    "@dynatrace-sdk/units": "^1.5.0",
    "@dynatrace-sdk/user-preferences": "^1.1.4",
    "@dynatrace/strato-components": "^3.8.0",
    "@dynatrace/strato-components-preview": "^3.4.1",
    "@dynatrace/strato-design-tokens": "^1.5.1",
    "@dynatrace/strato-icons": "^2.3.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-intl": "^10.1.14",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-plugin-sdl": "^1.1.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dt-app": "^1.12.1",
    "eslint": "^10.6.0",
    "eslint-plugin-n": "^18.2.1",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "tsx": "^3.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
