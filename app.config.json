{
  "$schema": "./.dt-app/app.config.schema.json",
  "environmentUrl": "https://yhu28601.apps.dynatrace.com/",
  "app": {
    "name": "Dynatrace All File Manager",
    "version": "0.5.0",
    "description": "A collection of file management utilities for Dynatrace",
    "id": "my.dt.file.manager",
    "scopes": [
      {
        "name": "storage:logs:read",
        "comment": "default template"
      },
      {
        "name": "storage:buckets:read",
        "comment": "default template"
      },
      {
        "name": "document:documents:read",
        "comment": "Read notebooks via Document API"
      },
      {
        "name": "document:documents:write",
        "comment": "Create notebooks via Document API"
      },
      {
        "name": "document:documents:delete",
        "comment": "Delete notebooks via Document API"
      },
      {
        "name": "document:environment-shares:read",
        "comment": "Read environment shares for documents"
      },
      {
        "name": "document:environment-shares:write",
        "comment": "Create environment shares for documents"
      },
      {
        "name": "document:environment-shares:delete",
        "comment": "Delete environment shares for documents"
      },
      {
        "name": "storage:files:read",
        "comment": "Read lookup files from Grail"
      },
      {
        "name": "storage:files:write",
        "comment": "Upload lookup files to Grail"
      },
      {
        "name": "storage:files:delete",
        "comment": "Delete lookup files from Grail"
      }
    ]
  }
}